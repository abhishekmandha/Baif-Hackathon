# This is an example environment file for the frontend.
# For local development, you can rename this file to `.env` and the settings will be loaded.

# The URL of your backend API. For local development, this should point to your local FastAPI server.
REACT_APP_API_URL="http://localhost:8000/api"

# EmailJS configuration (used in Settings.js)
# REACT_APP_EMAILJS_SERVICE_ID="your_emailjs_service_id"
# REACT_APP_EMAILJS_TEMPLATE_ID="your_emailjs_template_id"
# REACT_APP_EMAILJS_PUBLIC_KEY="your_emailjs_public_key"